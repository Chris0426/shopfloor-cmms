# Hermes gateway 環境變數一覽(僅文件,皆為佔位值)。
# docker compose(docker-compose.public.yml)下機密從 repo 根目錄的 .env 讀取,
# 本檔不會被載入;請複製成 .env 再填值,不要直接改本檔。
# 絕不可把真實金鑰提交進 git。

HERMES_BACKEND=anthropic  # codex(預設)或 anthropic;codex 需 CODEX_HOME 與 `codex login`,不用下面的金鑰
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME  # Anthropic 金鑰(僅 anthropic 後端)
HERMES_GATEWAY_SECRET=REPLACE_ME  # python -c "import secrets; print(secrets.token_urlsafe(32))";cmms app 端須設同值
CMMS_MCP_URL=http://app:8080/mcp  # cmms MCP 端點(compose 內網位址)
#BOARD_MCP_URL=http://board:8080/mcp  # board MCP 端點(無預設;未設時 target=board 回 503)
#HERMES_PERSONA_BOARD_FILE=/app/personas/board.md  # board persona 檔(未設 → 隨附的 personas/board.md)

#HERMES_LLM_TIMEOUT=120  # 整體逾時秒數
#HERMES_MAX_CONCURRENCY=2  # 同時處理的請求上限
#HERMES_LEDGER_PATH=/data/ledger.sqlite  # 用量帳本 SQLite 路徑
#HERMES_DAILY_BUDGET_USD=0.5  # 每日預算上限(美元;每個 target 各自一桶的預設值)
#HERMES_DAILY_BUDGET_USD_CMMS=0.5  # cmms 日預算覆寫(未設 → HERMES_DAILY_BUDGET_USD)
#HERMES_DAILY_BUDGET_USD_BOARD=0.5  # board 日預算覆寫(未設 → HERMES_DAILY_BUDGET_USD)
#HERMES_MONTHLY_BUDGET_USD=10.0  # 每月預算上限(美元;全 target 共用一池)
#HERMES_DAILY_QUESTIONS_PER_CLIENT=10  # 每個 client 每日提問上限(cmms)
#HERMES_DAILY_QUESTIONS_PER_CLIENT_BOARD=3  # 每個 client 每日提問上限(board,與 cmms 分開計)
#HERMES_MODEL_CHAT=claude-haiku-5-5  # 一般對話模型
#HERMES_MODEL_TEXT=claude-haiku-5-5  # 文字生成(對外摘要)模型
#HERMES_MODEL_DEEP=claude-sonnet-5-5  # 「詳細分析」類請求模型
